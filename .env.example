# Copy to .env and adjust. Never commit .env. Values below are local development defaults only.
APP_NAME="Ahí va mi café"
APP_ENV=development
SECRET_KEY=local-dev-secret-change-me-0123456789abcdef
DATABASE_URL=postgresql+psycopg://cafe:cafe@localhost:5432/cafe
REDIS_URL=redis://localhost:6379/0
QUEUE_MODE=rq
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# WhatsApp Cloud API (Meta). simulated | meta
WHATSAPP_PROVIDER=simulated
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=dev-verify-token
META_APP_SECRET=dev-app-secret
META_GRAPH_API_VERSION=v27.0
# Approved template used for notifications outside the 24 h service window (one body parameter).
WHATSAPP_NOTIFICATION_TEMPLATE=

# Azure OpenAI. simulated | azure
LLM_PROVIDER=simulated
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI Speech. simulated | azure
SPEECH_PROVIDER=simulated
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure AI Document Intelligence. simulated | azure
DOCUMENT_PROVIDER=simulated
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Evidence storage. local | azure
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=evidencias

# Geospatial layers loaded from prepared GeoJSON files.
GEO_PROVIDER=local
AZURE_MAPS_KEY=
GEOSPATIAL_DATA_PATH=../data/geospatial
CLIMATE_PROVIDER=disabled
CLIMATE_API_KEY=

LOG_LEVEL=INFO

# Demo business assumptions (not official standards).
ALERT_WEIGHT_PCT_THRESHOLD=0.50
ALERT_SACK_TOLERANCE=0
ARROBA_KG=12.5
CARGA_KG=125
DEFAULT_PRODUCER_ORG_CODE=COOP-HUILA

# Optional unit rates for cost estimation. Leave empty when unknown; no prices are assumed.
COST_RATE_LLM_PER_1K_TOKENS=
COST_RATE_SPEECH_PER_MINUTE=
COST_RATE_DOCUMENT_PER_PAGE=
COST_RATE_WHATSAPP_PER_MESSAGE=
